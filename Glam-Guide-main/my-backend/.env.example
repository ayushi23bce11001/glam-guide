# ===================================================
# Glam Guide - Environment Variables Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# MongoDB Database Connection URI (Local or MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017/glamguide

# JWT Secret for Signed Authentication Tokens & HttpOnly Cookies
JWT_SECRET=glam_guide_production_jwt_super_secret_key_change_me_in_prod

# AI Service Configuration (Google Gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# Optional Persistent Cloud Image Storage (Cloudinary)
# If left blank, images will be stored locally in my-backend/uploads/
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=
